{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ge360": {
      "type": "stdio",
      "command": "./.venv/bin/python",
      "args": [
        "${PLUGIN_ROOT}/mcp_server/server.py"
      ],
      "env": {
        "GE360_MCP_DB_PATH": "${PLUGIN_ROOT}/data/ge360.db"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
