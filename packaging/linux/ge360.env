# GE360 Analitica - configurazione locale
GE360_ENV=production
GE360_DB_PATH=/var/lib/ge360-analitica/ge360.db
GE360_GOOGLE_TOKEN_FILE=/var/lib/ge360-analitica/secrets/google_oauth.json
GE360_RUNTIME_CONFIG_FILE=/var/lib/ge360-analitica/secrets/runtime_config.json
GE360_AUTO_SYNC=true
GE360_SYNC_INTERVAL_MINUTES=60
GE360_LOG_LEVEL=info

# AI locale - usa Ollama già installato sul sistema
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# WordPress
WORDPRESS_BASE_URL=https://triesteincostruzione.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_GE360_KEY=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8788/api/oauth/google/callback
GOOGLE_BUSINESS_LOCATION_NAME=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=https://triesteincostruzione.com/

# Meta
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_VERSION=v26.0
META_REDIRECT_URI=http://127.0.0.1:8788/api/oauth/meta/callback
